{
  "name": "acp-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:fake": "cargo build -p fake-acp-agent && ACP_DESKTOP_FAKE_AGENT=1 npm run tauri dev",
    "test": "vitest run",
    "smoke:codex-acp": "node scripts/smoke-codex-acp.mjs",
    "smoke:claude-acp": "node scripts/smoke-claude-acp.mjs",
    "smoke:copilot-acp": "node scripts/smoke-copilot-acp.mjs",
    "tauri:build:macos": "tauri build --bundles app,dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.7"
  },
  "description": "Unofficial desktop ACP client"
}
